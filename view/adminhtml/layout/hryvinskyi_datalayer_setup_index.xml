<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!-- The setup wizard: one block the browser code renders into, and the wizard's look -->
    <head>
        <title>Set up GA4 tracking</title>
        <css src="Hryvinskyi_DataLayerAdminUi::css/setup-wizard.css"/>
    </head>
    <body>
        <referenceBlock name="breadcrumbs">
            <action method="addLink">
                <argument name="label" xsi:type="string" translate="true">Sales</argument>
                <argument name="title" xsi:type="string" translate="true">Sales</argument>
            </action>
            <action method="addLink">
                <argument name="label" xsi:type="string" translate="true">GA4 Data Layer</argument>
                <argument name="title" xsi:type="string" translate="true">GA4 Data Layer</argument>
            </action>
            <action method="addLink">
                <argument name="label" xsi:type="string" translate="true">Setup</argument>
                <argument name="title" xsi:type="string" translate="true">Setup</argument>
            </action>
        </referenceBlock>
        <!-- The wizard's frame carries the page heading; the admin's own title bar would repeat it -->
        <referenceBlock name="page.title" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="hryvinskyi.datalayer.setup"
                   template="Hryvinskyi_DataLayerAdminUi::setup/wizard.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Hryvinskyi\DataLayerAdminUi\ViewModel\SetupPage</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
