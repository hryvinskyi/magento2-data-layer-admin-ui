/**
 * The setup wizard's mount point: the root the browser code renders into, a loading line it replaces, the page
 * configuration as JSON, then the module tags that load it
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

$setupPage = $block->getData('view_model');
if (!$setupPage instanceof \Hryvinskyi\DataLayerAdminUi\ViewModel\SetupPage) {
    throw new \LogicException('The setup wizard template needs the setup page view model as "view_model".');
}
?>
<div data-role="hdl-setup" class="hdl-setup"
     data-failed-text="<?= $escaper->escapeHtmlAttr($setupPage->getFailedText()) ?>">
    <p class="hdl-setup__loading" data-role="hdl-setup-loading" role="status">
        <?= $escaper->escapeHtml($setupPage->getLoadingText()) ?>
    </p>
    <script type="application/json" data-role="hdl-setup-config"><?=
        /* @noEscape JSON with < and > escaped, so no value can end the element */
        $setupPage->getConfigJson()
    ?></script>
</div>
<?= /* @noEscape the import map and the entry module, rendered by the module script renderer */
    $setupPage->getScripts() ?>
