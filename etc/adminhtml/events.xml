<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Settings saved: everything the data layer cached depends on them -->
    <event name="admin_system_config_changed_section_hryvinskyi_datalayer">
        <observer name="hryvinskyi_datalayer_clean_on_settings_change"
                  instance="Hryvinskyi\DataLayerAdminUi\Observer\CleanOnSettingsChange"/>
    </event>
</config>
