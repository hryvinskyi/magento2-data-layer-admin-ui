<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Whether events routed to the server go anywhere: nowhere until a server-side delivery module answers -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\ServerDeliveryStateInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\NoServerDelivery"/>

    <!-- Admin ES modules: an import map resolves the names their modules import one another by -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\ModuleScriptInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\ModuleScript"/>

    <!-- The events table: one row per known event, saving the disabled events and the routing rows -->
    <type name="Hryvinskyi\DataLayerAdminUi\Block\Adminhtml\System\Config\EventsTable">
        <arguments>
            <argument name="channels" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Config\Source\Channels</argument>
        </arguments>
    </type>

    <!-- The two stored event settings, read the same way by the events table and the setup wizard -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Events\StoredEventSettingsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Events\StoredEventSettings"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Events\EventGroupLabelInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Events\EventGroupLabel"/>

    <!-- Setup wizard: the state it is given, read from the scope tree, the settings it edits and their stored,
         shipped and fixed values -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SetupStateProviderInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SetupStateProvider"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\ScopeTreeInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\ScopeTree"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\StoredSettingsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\StoredSettings"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\BuiltInDefaultsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\BuiltInDefaults"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SettingLocksInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingLocks"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SettingPresentationInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingPresentation"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\PatternTranslatorInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\PatternTranslator"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\EventsProjectionInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\EventsProjection"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\Data\SettingDescriptorInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\Data\SettingDescriptor"/>

    <!-- Setup wizard: how each kind of setting travels between the stored value and the browser, and which values
         each takes -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SettingKindsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingKinds"/>
    <type name="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingKinds">
        <arguments>
            <argument name="kinds" xsi:type="array">
                <item name="flag" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Kind\FlagKind</item>
                <item name="choice" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Kind\ChoiceKind</item>
                <item name="text" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Kind\TextKind</item>
                <item name="number" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Kind\NumberKind</item>
                <item name="secret" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Kind\SecretKind</item>
            </argument>
        </arguments>
    </type>

    <!-- Setup wizard: the settings it edits. Another module adds its own as items of the same argument -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SettingDescriptorsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingDescriptors"/>
    <type name="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingDescriptors">
        <arguments>
            <argument name="descriptors" xsi:type="array">
                <item name="enabled" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/general/enabled</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">connect</item>
                </item>
                <item name="container_id" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/gtm/container_id</item>
                    <item name="kind" xsi:type="string">text</item>
                    <item name="step" xsi:type="string">connect</item>
                    <item name="pattern" xsi:type="const">Hryvinskyi\DataLayer\Api\ConfigInterface::CONTAINER_ID_PATTERN</item>
                </item>
                <item name="script_host" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/gtm/script_host</item>
                    <item name="kind" xsi:type="string">text</item>
                    <item name="step" xsi:type="string">connect</item>
                    <item name="pattern" xsi:type="const">Hryvinskyi\DataLayer\Api\ConfigInterface::SCRIPT_HOST_PATTERN</item>
                </item>
                <item name="measurement_id" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/gtag/measurement_id</item>
                    <item name="kind" xsi:type="string">text</item>
                    <item name="step" xsi:type="string">connect</item>
                    <item name="pattern" xsi:type="const">Hryvinskyi\DataLayer\Api\ConfigInterface::MEASUREMENT_ID_PATTERN</item>
                    <item name="caseInsensitive" xsi:type="boolean">true</item>
                </item>
                <item name="item_id" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/item/identifier_attribute</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="brand" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/item/brand_attribute</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="tax_catalog" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/item/catalogue_price_includes_tax</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="tax_cart" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/item/line_price_includes_tax</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="hidden_price" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/item/hidden_price_handling</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="purchase_value" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/purchase/value_basis</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="deduct_tax" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/purchase/deduct_tax</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="include_tax" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/purchase/include_tax</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="include_shipping" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/purchase/include_shipping</item>
                    <item name="kind" xsi:type="string">flag</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="checkout_value" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/checkout/step_value_basis</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
                <item name="list_view" xsi:type="array">
                    <item name="path" xsi:type="string">hryvinskyi_datalayer/lists/impression_trigger</item>
                    <item name="kind" xsi:type="string">choice</item>
                    <item name="step" xsi:type="string">products</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Setup wizard: what each module adds to the page. Another module adds its own as an item of the same
         argument -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SetupContributionsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SetupContributions"/>
    <type name="Hryvinskyi\DataLayerAdminUi\Model\Setup\SetupContributions">
        <arguments>
            <argument name="contributions" xsi:type="array">
                <item name="core" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\CoreContribution</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\DataLayerAdminUi\Model\Setup\CoreContribution">
        <arguments>
            <!-- The wording of the wizard shell and its built-in steps, keyed as the browser code asks for it:
                 a count-dependent text has one key per plural category, placeholders are %1 to %n -->
            <argument name="phrases" xsi:type="array">
                <item name="wizard.title" xsi:type="string" translate="true">Set up GA4 tracking</item>
                <item name="wizard.loading" xsi:type="string" translate="true">Loading the setup wizard…</item>
                <item name="wizard.failed" xsi:type="string" translate="true">The setup wizard could not start. Reload the page, or use the advanced settings.</item>
                <item name="step.counter" xsi:type="string" translate="true">Step %1 of %2</item>
                <item name="step.scope.title" xsi:type="string" translate="true">Scope</item>
                <item name="step.scope.intro" xsi:type="string" translate="true">Most shops set everything up once at Default and override only a few settings per website.</item>
                <item name="step.connect.title" xsi:type="string" translate="true">Connect</item>
                <item name="step.connect.intro" xsi:type="string" translate="true">Choose how your store loads Google’s script.</item>
                <item name="step.track.title" xsi:type="string" translate="true">What to track</item>
                <item name="step.track.intro" xsi:type="string" translate="true">Pick the closest preset, then fine-tune single events.</item>
                <item name="step.products.title" xsi:type="string" translate="true">Products and prices</item>
                <item name="step.products.intro" xsi:type="string" translate="true">Choose which product data and prices GA4 receives.</item>
                <item name="step.review.title" xsi:type="string" translate="true">Review and save</item>
                <item name="step.review.intro" xsi:type="string" translate="true">Nothing reaches the store until you click Save all.</item>
                <item name="step.status.current" xsi:type="string" translate="true">In progress</item>
                <item name="step.status.current_attention" xsi:type="string" translate="true">In progress · needs attention</item>
                <item name="step.status.attention" xsi:type="string" translate="true">Needs attention</item>
                <item name="step.status.done" xsi:type="string" translate="true">Done</item>
                <item name="action.continue" xsi:type="string" translate="true">Continue</item>
                <item name="action.back" xsi:type="string" translate="true">Back</item>
                <item name="action.skip" xsi:type="string" translate="true">Skip this step</item>
                <item name="action.save_all" xsi:type="string" translate="true">Save all</item>
                <item name="action.close" xsi:type="string" translate="true">Close</item>
                <item name="action.advanced" xsi:type="string" translate="true">Advanced settings</item>
                <item name="action.override" xsi:type="string" translate="true">Override here</item>
                <item name="action.inherit" xsi:type="string" translate="true">Use inherited value</item>
                <item name="footer.unsaved.one" xsi:type="string" translate="true">%1 unsaved change</item>
                <item name="footer.unsaved.other" xsi:type="string" translate="true">%1 unsaved changes</item>
                <item name="footer.unsaved_note" xsi:type="string" translate="true">saved with Save all in the last step</item>
                <item name="footer.none" xsi:type="string" translate="true">No unsaved changes</item>
                <item name="footer.all_saved" xsi:type="string" translate="true">All changes saved</item>
                <item name="leave.confirm" xsi:type="string" translate="true">You have unsaved changes. Leave the setup wizard and lose them?</item>
                <item name="scope.default" xsi:type="string" translate="true">Default · All websites</item>
                <item name="scope.website" xsi:type="string" translate="true">Website · %1</item>
                <item name="scope.store" xsi:type="string" translate="true">Store view · %1</item>
                <item name="scope.default.applies" xsi:type="string" translate="true">Applies to all websites and store views that do not override it.</item>
                <item name="scope.website.applies" xsi:type="string" translate="true">Applies to the %1 website and its store views that do not override it.</item>
                <item name="scope.store.applies" xsi:type="string" translate="true">Applies to the %1 store view only. Nothing inherits from it.</item>
                <item name="scope.single_website" xsi:type="string" translate="true">Your shop has one website, so Default is selected. You can skip this step.</item>
                <item name="scope.skip_to_connect" xsi:type="string" translate="true">Skip to Connect</item>
                <item name="scope.uses_default" xsi:type="string" translate="true">Uses Default for everything</item>
                <item name="scope.inherits_from" xsi:type="string" translate="true">Inherits from %1</item>
                <item name="origin.inherited" xsi:type="string" translate="true">Inherited from %1</item>
                <item name="origin.default" xsi:type="string" translate="true">Default · used by every website</item>
                <item name="origin.website" xsi:type="string" translate="true">Set for this website</item>
                <item name="origin.store" xsi:type="string" translate="true">Set for this store view</item>
                <item name="origin.reach.website" xsi:type="string" translate="true">Website setting — switch scope to %1</item>
                <item name="origin.reach.default" xsi:type="string" translate="true">Default setting — switch scope to Default</item>
                <item name="mode.label" xsi:type="string" translate="true">How pages load Google</item>
                <item name="mode.gtm" xsi:type="string" translate="true">Google Tag Manager container</item>
                <item name="mode.gtm.description" xsi:type="string" translate="true">Tags live in your GTM container. The store fills the data layer.</item>
                <item name="mode.gtag" xsi:type="string" translate="true">Google Analytics directly (gtag.js)</item>
                <item name="mode.gtag.description" xsi:type="string" translate="true">The store loads Google Analytics itself.</item>
                <item name="mode.both" xsi:type="string" translate="true">Both</item>
                <item name="mode.both.description" xsi:type="string" translate="true">Loads the container and gtag.js.</item>
                <item name="connect.card" xsi:type="string" translate="true">Google connection</item>
                <item name="connect.host_disclosure" xsi:type="string" translate="true">Using a first-party or server-side GTM domain?</item>
