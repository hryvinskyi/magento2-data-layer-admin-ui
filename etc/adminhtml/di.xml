                <item name="products.card.values" xsi:type="string" translate="true">Purchase and checkout values</item>
                <item name="preview.title.view_item" xsi:type="string" translate="true">This is what a product page sends</item>
                <item name="preview.title.purchase" xsi:type="string" translate="true">This is what an order sends</item>
                <item name="preview.tab.view_item" xsi:type="string" translate="true">Product page</item>
                <item name="preview.tab.purchase" xsi:type="string" translate="true">Purchase</item>
                <item name="preview.search" xsi:type="string" translate="true">Search a product by name or SKU</item>
                <item name="preview.loading" xsi:type="string" translate="true">Loading preview…</item>
                <item name="preview.viewer.visible" xsi:type="string" translate="true">Visitor sees prices</item>
                <item name="preview.viewer.hidden" xsi:type="string" translate="true">Visitor may not see prices</item>
                <item name="review.nothing.title" xsi:type="string" translate="true">Nothing to save</item>
                <item name="review.nothing.text" xsi:type="string" translate="true">Every setting matches what is stored. Go back to a step to change something.</item>
                <item name="review.changes" xsi:type="string" translate="true">Changes</item>
                <item name="review.column.setting" xsi:type="string" translate="true">Setting</item>
                <item name="review.column.current" xsi:type="string" translate="true">Current</item>
