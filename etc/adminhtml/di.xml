                <item name="field.enabled.help" xsi:type="string" translate="true">When No, the store outputs no Google script.</item>
                <item name="field.script_host.help" xsi:type="string" translate="true">Host name only. Leave empty for Google’s standard host.</item>
                <item name="field.item_id.help" xsi:type="string" translate="true">What GA4 receives as item_id.</item>
                <item name="field.brand.help" xsi:type="string" translate="true">Fills item_brand.</item>
                <item name="field.tax_catalog.help" xsi:type="string" translate="true">Yes: product and list prices are sent with tax.</item>
                <item name="field.tax_cart.help" xsi:type="string" translate="true">Yes: cart, checkout and order prices are sent with tax.</item>
                <item name="field.hidden_price.help" xsi:type="string" translate="true">For customer groups that may not see prices.</item>
                <item name="field.purchase_value.help" xsi:type="string" translate="true">What GA4 reports as revenue.</item>
                <item name="field.checkout_value.help" xsi:type="string" translate="true">Sent with the checkout steps.</item>
                <item name="field.list_view.help" xsi:type="string" translate="true">Scrolls into view is more accurate for long pages.</item>
                <item name="status.loader.ok" xsi:type="string" translate="true">Loader OK</item>
                <item name="status.loader.ok.note" xsi:type="string" translate="true">Every storefront page at this scope loads it.</item>
                <item name="status.loader.empty" xsi:type="string" translate="true">Waiting for an ID</item>
