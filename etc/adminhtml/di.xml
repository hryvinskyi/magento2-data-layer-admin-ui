                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\InitialScope"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SetupSessionInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SetupSession"/>
