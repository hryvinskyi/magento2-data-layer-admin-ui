    <virtualType name="HryvinskyiDataLayerIdentifierAttributes"
                 type="Hryvinskyi\DataLayerAdminUi\Model\Config\Source\ProductAttributes">
        <arguments>
            <argument name="field" xsi:type="string">backend_type</argument>
            <argument name="values" xsi:type="array">
                <item name="varchar" xsi:type="string">varchar</item>
                <item name="text" xsi:type="string">text</item>
                <item name="static" xsi:type="string">static</item>
            </argument>
            <argument name="leadingOptions" xsi:type="array">
                <item name="product_id" xsi:type="array">
                    <item name="value" xsi:type="string">entity_id</item>
                    <item name="label" xsi:type="string" translate="true">Product ID</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

