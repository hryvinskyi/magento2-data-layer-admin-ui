    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\Http\ProductSearchRequestReaderInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\Http\ProductSearchRequestReader"/>

    <!-- The setup page prints its configuration inside a script element, so the JSON escapes every character that
         could end it -->
    <type name="Hryvinskyi\DataLayerAdminUi\ViewModel\SetupPage">
        <arguments>
            <argument name="json" xsi:type="object">Magento\Framework\Serialize\Serializer\JsonHexTag</argument>
        </arguments>
    </type>

    <!-- The configuration page's field stored under a config path, found one way by everything the wizard reads
         from the page -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\ConfigFieldLookupInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\ConfigFieldLookup"/>

    <!-- A setting another module adds from another section of the configuration page is shown and saved only for a
         user that section's access rule allows -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SettingAccessInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SettingAccess"/>

