                <item name="events" xsi:type="object">Hryvinskyi\DataLayerAdminUi\Model\Setup\Fields\EventsSettingFields</item>
            </argument>
        </arguments>
    </type>

    <!-- Setup wizard: its page. The page configuration puts the contributions together, builds every admin address
         the browser needs and opens at the scope the request names, and the session endpoint hands out a new session's
         form key and addresses; each endpoint reads its request through its own reader and answers through one JSON
         answer -->
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\MergedContributionsInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\MergedContributions"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\SetupPageConfigInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\SetupPageConfig"/>
