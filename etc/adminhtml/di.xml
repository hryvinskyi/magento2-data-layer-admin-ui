                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\Data\ScopeId"/>
    <preference for="Hryvinskyi\DataLayerAdminUi\Api\Setup\Data\ScopedValuesInterface"
                type="Hryvinskyi\DataLayerAdminUi\Model\Setup\Data\ScopedValues"/>
