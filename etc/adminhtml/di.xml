                <item name="error.format" xsi:type="string" translate="true">This value does not have the expected format.</item>
                <item name="error.range" xsi:type="string" translate="true">This value is outside the allowed range.</item>
                <item name="error.container_id.required" xsi:type="string" translate="true">Enter a container ID, or switch sending off.</item>
                <item name="error.container_id.format" xsi:type="string" translate="true">Use the format GTM- followed by letters and digits, for example GTM-AB12CD3.</item>
                <item name="error.measurement_id.required" xsi:type="string" translate="true">Enter a Measurement ID.</item>
                <item name="error.measurement_id.format" xsi:type="string" translate="true">Use the format G- followed by letters and digits, for example G-7KQ2XM4P1N.</item>
                <item name="error.script_host.format" xsi:type="string" translate="true">Host name only, for example gtm.example.com — no “https://” or path.</item>
                <item name="track.events" xsi:type="string" translate="true">Events</item>
                <item name="track.column.event" xsi:type="string" translate="true">Event</item>
                <item name="track.column.trigger" xsi:type="string" translate="true">What triggers it</item>
                <item name="track.column.source" xsi:type="string" translate="true">Where it comes from</item>
                <item name="track.column.send" xsi:type="string" translate="true">Send</item>
                <item name="track.column.channel" xsi:type="string" translate="true">Channel</item>
                <item name="track.sent" xsi:type="string" translate="true">%1 of %2 sent</item>
                <item name="track.from_server.one" xsi:type="string" translate="true">%1 from the server</item>
                <item name="track.from_server.other" xsi:type="string" translate="true">%1 from the server</item>
                <item name="track.group.count" xsi:type="string" translate="true">%1 of %2</item>
                <item name="preset.custom" xsi:type="string" translate="true">Custom</item>
                <item name="preset.custom.description" xsi:type="string" translate="true">Selected automatically: the table differs from every preset.</item>
                <item name="preset.events.one" xsi:type="string" translate="true">%1 event</item>
                <item name="preset.events.other" xsi:type="string" translate="true">%1 events</item>
                <item name="channel.browser" xsi:type="string" translate="true">Browser</item>
                <item name="channel.server" xsi:type="string" translate="true">Server</item>
                <item name="channel.both" xsi:type="string" translate="true">Both</item>
                <item name="channel.fixed.browser" xsi:type="string" translate="true">Browser · fixed</item>
