                <item name="status.loader.invalid.note" xsi:type="string" translate="true">Nothing is output until it’s fixed.</item>
                <item name="status.loader.off" xsi:type="string" translate="true">Sending is off</item>
                <item name="status.loader.off.note" xsi:type="string" translate="true">No Google script is output.</item>
                <item name="status.output" xsi:type="string" translate="true">What the store outputs</item>
                <item name="status.tag_assistant" xsi:type="string" translate="true">Open Tag Assistant</item>
