{
    "name": "@hryvinskyi/datalayer-setup-wizard",
    "description": "Sources of the GA4 data layer setup wizard: the domain model, the plugin SDK and the Preact shell, built into view/adminhtml/web/js/setup/.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.15"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.domain.json",
        "test": "node --import tsx --import ./test/setup-dom.ts --test 'src/**/*.test.{ts,tsx}'",
        "verify-build": "node scripts/verify-build.mjs"
    },
    "devDependencies": {
        "@fontsource/source-sans-3": "5.3.0",
        "@happy-dom/global-registrator": "20.14.5",
        "@testing-library/preact": "3.2.4",
        "@types/node": "26.6.3",
        "esbuild": "0.28.2",
        "happy-dom": "20.14.5",
        "preact": "10.29.8",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
